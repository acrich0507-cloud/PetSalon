PORT=8080

# Supabase project URL, for example: https://xxxx.supabase.co
SUPABASE_URL=

# Use service role key on backend only
SUPABASE_SERVICE_PETSALON_KEY=

# Supabase schema used by backend table access
# Example: petsalon or PigusuPetSalon
SUPABASE_SCHEMA=petsalon

# Comma-separated allowlist, for example:
# https://your-account.github.io,https://your-custom-domain.com
CORS_ORIGINS=
